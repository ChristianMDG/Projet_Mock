# Production Environment Variables - Platform Agnostic

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
HOST=0.0.0.0
PORT=${PORT:-1337}
NODE_ENV=production

# =============================================================================
# DATABASE CONFIGURATION (Shared with main app)
# =============================================================================
DATABASE_CLIENT=postgres
DATABASE_URL=${DATABASE_URL}
DATABASE_HOST=${DATABASE_HOST:-postgres}
DATABASE_PORT=${DATABASE_PORT:-5432}
DATABASE_NAME=${DATABASE_NAME:-taxibrousse}
DATABASE_USERNAME=${DATABASE_USERNAME}
DATABASE_PASSWORD=${DATABASE_PASSWORD}
DATABASE_SSL=${DATABASE_SSL:-true}
DATABASE_SCHEMA=${DATABASE_SCHEMA:-public}

# =============================================================================
# CLOUDINARY CONFIGURATION
# =============================================================================
CLOUDINARY_NAME=${CLOUDINARY_NAME}
CLOUDINARY_KEY=${CLOUDINARY_KEY}
CLOUDINARY_SECRET=${CLOUDINARY_SECRET}

# =============================================================================
# CMS SECRETS (Strapi Configuration)
# =============================================================================
APP_KEYS=${CMS_APP_KEYS}
API_TOKEN_SALT=${CMS_API_TOKEN_SALT}
ADMIN_JWT_SECRET=${CMS_ADMIN_JWT_SECRET}
TRANSFER_TOKEN_SALT=${CMS_TRANSFER_TOKEN_SALT}
JWT_SECRET=${CMS_JWT_SECRET}

# =============================================================================
# CMS FEATURE FLAGS
# =============================================================================
FLAG_NPS=${FLAG_NPS:-true}
FLAG_PROMOTE_EE=${FLAG_PROMOTE_EE:-true}

# =============================================================================
# FRONTEND INTEGRATION
# =============================================================================
CLIENT_URL=${TAXIBROUSSE_URL}
FRONTEND_URL=${TAXIBROUSSE_URL}
PREVIEW_SECRET=${PREVIEW_SECRET}
