{
  "collectionName": "components_rental_hero_sections",
  "info": {
    "displayName": "Hero Section",
    "description": "Hero banner with headline, subtitle, and an integrated search form for the rental home page",
    "icon": "search"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200,
      "default": "Louez votre véhicule à Madagascar",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "subtitle": {
      "type": "string",
      "maxLength": 400,
      "default": "Voitures, SUV et utilitaires disponibles partout à Madagascar",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "backgroundImageUrl": {
      "type": "string",
      "maxLength": 300,
      "description": "Alternative background image URL if no upload"
    },
    "overlayOpacity": {
      "type": "decimal",
      "default": 0.65,
      "min": 0,
      "max": 1,
      "description": "Overlay opacity on the background image (0 = transparent, 1 = opaque)"
    },
    "backgroundColor": {
      "type": "string",
      "maxLength": 50,
      "default": "primary.main",
      "description": "Overlay/background color (e.g. primary.main, background.paper)"
    }
  }
}
