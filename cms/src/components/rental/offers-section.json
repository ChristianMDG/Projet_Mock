{
  "collectionName": "components_rental_offers_sections",
  "info": {
    "displayName": "Offers Section",
    "description": "Current rental promotions, deals, and special offers",
    "icon": "gift"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200,
      "default": "Nos offres du moment",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "subtitle": {
      "type": "string",
      "maxLength": 300,
      "default": "Profitez de nos meilleures promotions sur la location de véhicules",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "offers": {
      "type": "component",
      "repeatable": true,
      "component": "rental.offer-item",
      "required": true,
      "min": 1,
      "max": 6
    },
    "backgroundColor": {
      "type": "string",
      "maxLength": 50,
      "default": "background.paper",
      "description": "Section background color (e.g. background.paper, background.default)"
    },
    "containerMaxWidth": {
      "type": "enumeration",
      "enum": ["xs", "sm", "md", "lg", "xl"],
      "default": "lg"
    }
  }
}
