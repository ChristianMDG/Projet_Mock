{
  "collectionName": "components_page_travel_destination_items",
  "info": {
    "displayName": "Travel Destination Item",
    "description": "Une destination de voyage avec image et informations",
    "icon": "plane"
  },
  "options": {},
  "attributes": {
    "city": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "country": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "link": {
      "type": "string"
    },
    "gridSize": {
      "type": "enumeration",
      "enum": ["small", "medium", "large"],
      "default": "medium"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
