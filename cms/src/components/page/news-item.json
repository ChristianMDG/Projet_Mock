{
  "collectionName": "components_page_news_items",
  "info": {
    "displayName": "News Item",
    "description": "Un article d'actualité individuel",
    "icon": "fileText"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "category": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "link": {
      "type": "string",
      "required": false
    },
    "buttonText": {
      "type": "string",
      "default": "En savoir plus",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
