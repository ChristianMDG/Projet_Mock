{
    "kind": "collectionType",
    "collectionName": "promotional_campaigns",
    "info": {
        "singularName": "promotional-campaign",
        "pluralName": "promotional-campaigns",
        "displayName": "Promotional Campaign",
        "description": "Shop promotional campaign with discount rules"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "maxLength": 180,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "slug": {
            "type": "uid",
            "targetField": "name",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "description": {
            "type": "text",
            "required": false,
            "maxLength": 800,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "discountType": {
            "type": "enumeration",
            "enum": [
                "PERCENTAGE",
                "FIXED",
                "BUY_X_GET_Y",
                "FREE_SHIPPING"
            ],
            "default": "PERCENTAGE",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "discountValue": {
            "type": "decimal",
            "required": true,
            "min": 0,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "code": {
            "type": "string",
            "maxLength": 60,
            "unique": true,
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "startDate": {
            "type": "datetime",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "endDate": {
            "type": "datetime",
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "usageLimit": {
            "type": "integer",
            "min": 0,
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "usageCount": {
            "type": "integer",
            "default": 0,
            "min": 0,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "minOrderAmount": {
            "type": "decimal",
            "min": 0,
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "image": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ],
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "isActive": {
            "type": "boolean",
            "default": true,
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "products": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::product.product",
            "inversedBy": "campaigns"
        },
        "categories": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::product-category.product-category"
        },
        "seo": {
            "type": "component",
            "component": "shared.seo",
            "repeatable": false,
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        }
    }
}