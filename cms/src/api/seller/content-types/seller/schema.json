{
    "kind": "collectionType",
    "collectionName": "sellers",
    "info": {
        "singularName": "seller",
        "pluralName": "sellers",
        "displayName": "Seller",
        "description": "Shop seller / merchant profile"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "maxLength": 180,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "slug": {
            "type": "uid",
            "targetField": "name",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "location": {
            "type": "string",
            "required": false,
            "maxLength": 160,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "rating": {
            "type": "decimal",
            "default": 0,
            "min": 0,
            "max": 5,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "productCount": {
            "type": "integer",
            "default": 0,
            "min": 0,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "avatarImage": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ],
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "products": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::product.product",
            "mappedBy": "seller"
        }
    }
}
