{
    "kind": "collectionType",
    "collectionName": "products",
    "info": {
        "singularName": "product",
        "pluralName": "products",
        "displayName": "Product",
        "description": "Shop product catalog entry"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "maxLength": 255,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "slug": {
            "type": "uid",
            "targetField": "name",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "description": {
            "type": "richtext",
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "shortDescription": {
            "type": "text",
            "required": false,
            "maxLength": 500,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "price": {
            "type": "decimal",
            "required": true,
            "min": 0,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "originalPrice": {
            "type": "decimal",
            "required": false,
            "min": 0,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "currency": {
            "type": "string",
            "default": "MGA",
            "maxLength": 8,
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "sku": {
            "type": "string",
            "maxLength": 80,
            "unique": true,
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "weight": {
            "type": "decimal",
            "required": false,
            "min": 0,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "dimensions": {
            "type": "string",
            "required": false,
            "maxLength": 120,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "origin": {
            "type": "string",
            "required": false,
            "maxLength": 120,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "images": {
            "type": "media",
            "multiple": true,
            "required": false,
            "allowedTypes": [
                "images"
            ],
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "tags": {
            "type": "json",
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "specifications": {
            "type": "json",
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "inStock": {
            "type": "boolean",
            "default": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "stockQuantity": {
            "type": "integer",
            "default": 0,
            "min": 0,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "rating": {
            "type": "decimal",
            "default": 0,
            "min": 0,
            "max": 5,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "reviewCount": {
            "type": "integer",
            "default": 0,
            "min": 0,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "isActive": {
            "type": "boolean",
            "default": true,
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "isFeatured": {
            "type": "boolean",
            "default": false,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "isNew": {
            "type": "boolean",
            "default": false,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "isBestSeller": {
            "type": "boolean",
            "default": false,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "category": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::product-category.product-category",
            "inversedBy": "products"
        },
        "seller": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::seller.seller",
            "inversedBy": "products"
        },
        "variants": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::product-variant.product-variant",
            "mappedBy": "product"
        },
        "campaigns": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::promotional-campaign.promotional-campaign",
            "mappedBy": "products"
        },
        "seo": {
            "type": "component",
            "component": "shared.seo",
            "repeatable": false,
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        }
    }
}