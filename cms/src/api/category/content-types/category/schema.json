{
    "kind": "collectionType",
    "collectionName": "categories",
    "info": {
        "singularName": "category",
        "pluralName": "categories",
        "displayName": "Category",
        "description": "Top-level category that groups one or many product subcategories"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "maxLength": 150,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "description": {
            "type": "text",
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "slug": {
            "type": "uid",
            "targetField": "name",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "isActive": {
            "type": "boolean",
            "default": true,
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "displayOrder": {
            "type": "integer",
            "default": 0,
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "icon": {
            "type": "string",
            "required": false,
            "maxLength": 60,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "image": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ],
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "subcategories": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::product-category.product-category",
            "mappedBy": "category"
        }
    }
}
