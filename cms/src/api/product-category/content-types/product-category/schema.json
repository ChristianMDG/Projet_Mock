{
    "kind": "collectionType",
    "collectionName": "product_categories",
    "info": {
        "singularName": "product-category",
        "pluralName": "product-categories",
        "displayName": "Product Category",
        "description": "Catalogue subcategory for shop products, owned by a top-level Category"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        }
    },
    "attributes": {
        "name": {
            "type": "string",
            "required": true,
            "maxLength": 150,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "slug": {
            "type": "uid",
            "targetField": "name",
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "description": {
            "type": "text",
            "required": false,
            "maxLength": 500,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        },
        "icon": {
            "type": "string",
            "required": false,
            "maxLength": 60,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "image": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images"
            ],
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "displayOrder": {
            "type": "integer",
            "default": 0,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "isActive": {
            "type": "boolean",
            "default": true,
            "required": true,
            "pluginOptions": {
                "i18n": {
                    "localized": false
                }
            }
        },
        "category": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::category.category",
            "inversedBy": "subcategories",
            "required": true
        },
        "products": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::product.product",
            "mappedBy": "category"
        },
        "seo": {
            "type": "component",
            "component": "shared.seo",
            "repeatable": false,
            "required": false,
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            }
        }
    }
}