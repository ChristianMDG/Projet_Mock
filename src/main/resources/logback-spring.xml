<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Include Spring Boot's default configuration -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <!-- Properties -->
    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}/}taxibrousse-api.log}"/>
    <property name="LOGSTASH_HOST" value="${LOGSTASH_HOST:-logstash}"/>
    <property name="LOGSTASH_PORT" value="${LOGSTASH_PORT:-5001}"/>
    
    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %cyan([%thread]) %yellow(%logger{36}) : %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- File Appender (for production and default profiles) -->
    <springProfile name="production | default">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_FILE}</file>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} : %msg%n</pattern>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.gz</fileNamePattern>
                <maxHistory>7</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>
    </springProfile>
    
    <!-- Logstash TCP Appender (only for production) -->
    <springProfile name="production">
        <appender name="LOGSTASH" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${LOGSTASH_HOST}:${LOGSTASH_PORT}</destination>

            <!-- Reconnection strategy -->
            <reconnectionDelay>10 seconds</reconnectionDelay>

            <!-- Use ring buffer for async processing -->
            <ringBufferSize>8192</ringBufferSize>

            <!-- Encoder for JSON output -->
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- Service identification -->
                <customFields>{"service":"taxibrousse-api","service_type":"spring-boot"}</customFields>

                <!-- Include context information -->
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>spanId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>requestId</includeMdcKeyName>

                <!-- Include caller data for better debugging -->
                <includeCallerData>true</includeCallerData>

                <!-- Include context name -->
                <includeContext>true</includeContext>

                <!-- Stack trace configuration -->
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>30</maxDepthPerThrowable>
                    <maxLength>2048</maxLength>
                    <shortenedClassNameLength>20</shortenedClassNameLength>
                    <exclude>^sun\.reflect\..*\.invoke</exclude>
                    <exclude>^net\.sf\.cglib\.proxy\.MethodProxy\.invoke</exclude>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
            </encoder>

            <!-- Keep alive strategy -->
            <keepAliveDuration>5 minutes</keepAliveDuration>

            <!-- Write timeout -->
            <writeTimeout>1 minute</writeTimeout>
        </appender>

        <!-- Async Logstash Appender for non-blocking logging -->
        <appender name="ASYNC_LOGSTASH" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="LOGSTASH"/>
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <includeCallerData>true</includeCallerData>
            <neverBlock>true</neverBlock>
        </appender>
    </springProfile>
    
    <!-- Spring profiles -->
    <springProfile name="production">
        <!-- Application loggers -->
        <logger name="mg.taxibrousse" level="INFO"/>

        <!-- Framework loggers -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.springframework.web.servlet" level="WARN"/>
        <logger name="org.springframework.web.socket" level="WARN"/>
        <logger name="org.springframework.messaging" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>

        <!-- Third-party loggers -->
        <logger name="com.zaxxer.hikari" level="WARN"/>
        <logger name="io.lettuce.core" level="WARN"/>
        <logger name="org.apache.catalina" level="WARN"/>
        <logger name="org.apache.tomcat" level="WARN"/>

        <!-- Root logger -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ASYNC_LOGSTASH"/>
        </root>
    </springProfile>

    <springProfile name="default">
        <!-- Application loggers -->
        <logger name="mg.taxibrousse" level="INFO"/>

        <!-- Framework loggers -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>

        <!-- Root logger (no Logstash for default profile) -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <springProfile name="dev,local">
        <!-- More verbose logging for development -->
        <logger name="mg.taxibrousse" level="DEBUG"/>
        <logger name="org.springframework.web" level="DEBUG"/>
        <logger name="org.springframework.web.servlet" level="DEBUG"/>
        <logger name="org.springframework.web.socket" level="DEBUG"/>
        <logger name="org.springframework.messaging" level="DEBUG"/>
        <logger name="org.springframework.security" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <!-- Skip file and Logstash in local dev -->
        </root>
    </springProfile>

    <springProfile name="test">
        <!-- Minimal logging for tests -->
        <logger name="mg.taxibrousse" level="DEBUG"/>
        <logger name="org.springframework" level="WARN"/>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
