{
  "name": "dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.prod.ts",
    "dev:vite": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build --mode production",
    "build:server": "SSR_BUILD=true vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/roboto": "^5.2.5",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@mui/x-charts": "^8.27.0",
    "@mui/x-date-pickers": "^8.27.2",
    "@stomp/stompjs": "^7.0.0",
    "@tanstack/react-query": "^5.80.6",
    "@toolpad/core": "^0.16.0",
    "axios": "^1.9.0",
    "dayjs": "^1.11.20",
    "express": "^4.22.1",
    "i18next": "^25.8.13",
    "material-react-table": "^3.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.6.2",
    "sockjs-client": "^1.6.1",
    "tsx": "^4.21.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.91.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
