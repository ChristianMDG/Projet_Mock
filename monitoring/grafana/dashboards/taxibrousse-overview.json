{
  "uid": "taxibrousse-overview",
  "title": "Taxibrousse — Overview",
  "description": "HTTP metrics, JVM health, and structured logs for the Taxibrousse API with interactive drilldown",
  "tags": ["taxibrousse", "spring-boot", "api", "loki", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "container",
        "title": "Container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(container)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": false
      },
      {
        "name": "log_level",
        "title": "Log Level",
        "type": "custom",
        "query": "All, ERROR, WARN, INFO, DEBUG",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "📊 HTTP — Requests & Errors",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Request Rate (req/s)",
      "description": "Total incoming HTTP requests per second by method and URI. Click data link to drilldown into logs.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "links": [
            {
              "title": "🔍 Drilldown to Loki Logs for this Time Range",
              "url": "/explore?left=[\"${__from}\",\"${__to}\",\"loki\",{\"expr\":\"{container=~\".*taxibrousse-api.*\"} | json\"}]",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"taxibrousse-api\", uri!~\".*actuator.*\"}[1m]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP Error Rate (4xx / 5xx)",
      "description": "Rate of HTTP 4xx and 5xx responses. Click data link to view error logs in Explore.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "links": [
            {
              "title": "🚨 Drilldown to Error Logs in Explore",
              "url": "/explore?left=[\"${__from}\",\"${__to}\",\"loki\",{\"expr\":\"{container=~\".*taxibrousse-api.*\"} | json | level=~\\\"ERROR|WARN\\\"\"}]",
              "targetBlank": true
            }
          ]
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"taxibrousse-api\", status=~\"4..\"}[1m]))",
          "legendFormat": "4xx",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"taxibrousse-api\", status=~\"5..\"}[1m]))",
          "legendFormat": "5xx",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP P95 / P99 Latency",
      "description": "95th and 99th percentile response times",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "links": [
            {
              "title": "⏱️ Drilldown to Latency Logs",
              "url": "/explore?left=[\"${__from}\",\"${__to}\",\"loki\",{\"expr\":\"{container=~\".*taxibrousse-api.*\"} | json\"}]",
              "targetBlank": true
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"taxibrousse-api\", uri!~\".*actuator.*\"}[5m])))",
          "legendFormat": "P95 {{uri}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"taxibrousse-api\", uri!~\".*actuator.*\"}[5m])))",
          "legendFormat": "P99 {{uri}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active HTTP Connections",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 50 },
            { "color": "red", "value": 100 }
          ]},
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "expr": "tomcat_connections_current_connections{job=\"taxibrousse-api\"}",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "expr": "process_uptime_seconds{job=\"taxibrousse-api\"}",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Total Requests (last 5m)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "expr": "round(increase(http_server_requests_seconds_count{job=\"taxibrousse-api\", uri!~\".*actuator.*\"}[5m]))",
          "legendFormat": "Requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Error Rate %",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 5 }
          ]}
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"taxibrousse-api\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"taxibrousse-api\"}[5m]))",
          "legendFormat": "Error %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "🧠 JVM — Memory & Threads",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "JVM Heap Memory",
      "description": "Used vs committed JVM heap memory",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 20 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"taxibrousse-api\", area=\"heap\"}",
          "legendFormat": "Heap Used — {{id}}",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_committed_bytes{job=\"taxibrousse-api\", area=\"heap\"}",
          "legendFormat": "Heap Committed — {{id}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM Non-Heap & Buffer Memory",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"taxibrousse-api\", area=\"nonheap\"}",
          "legendFormat": "Non-heap — {{id}}",
          "refId": "A"
        },
        {
          "expr": "jvm_buffer_memory_used_bytes{job=\"taxibrousse-api\"}",
          "legendFormat": "Buffer — {{id}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "JVM Threads",
      "description": "Live, daemon, and peak thread counts",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=\"taxibrousse-api\"}",
          "legendFormat": "Live threads",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{job=\"taxibrousse-api\"}",
          "legendFormat": "Daemon threads",
          "refId": "B"
        },
        {
          "expr": "jvm_threads_peak_threads{job=\"taxibrousse-api\"}",
          "legendFormat": "Peak threads",
          "refId": "C"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "JVM Garbage Collection",
      "description": "GC pause time rate (seconds/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{job=\"taxibrousse-api\"}[1m])",
          "legendFormat": "GC Pause — {{action}} {{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "🗄️ Database & Connection Pool (HikariCP)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "HikariCP Connection Pool",
      "description": "Active, idle, and pending connections. Click data link to drilldown to Postgres logs.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "links": [
            {
              "title": "🗄️ View PostgreSQL Logs",
              "url": "/explore?left=[\"${__from}\",\"${__to}\",\"loki\",{\"expr\":\"{container=~\".*taxibrousse-postgres.*\"}\"}]",
              "targetBlank": true
            }
          ]
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Active" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "Idle" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Pending" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"taxibrousse-api\"}",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{job=\"taxibrousse-api\"}",
          "legendFormat": "Idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{job=\"taxibrousse-api\"}",
          "legendFormat": "Pending",
          "refId": "C"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "HikariCP Connection Acquire Time (P95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hikaricp_connections_acquire_seconds_bucket{job=\"taxibrousse-api\"}[5m])))",
          "legendFormat": "P95 acquire time",
          "refId": "A"
        }
      ]
    },
    {
      "id": 17,
      "type": "row",
      "title": "📝 Logs — Structured (Loki)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "collapsed": false
    },
    {
      "id": 18,
      "type": "logs",
      "title": "API Errors & Warnings",
      "description": "ERROR and WARN level logs filtered by selected Container and Log Level variables",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{container=~\"$container\"} | json | level =~ \"$log_level\" | level =~ \"ERROR|WARN\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Log Volume by Level",
      "description": "Number of log lines per level over time",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 54 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "WARN" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "INFO" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "DEBUG" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "gray" } }] }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }
      },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({container=~\"$container\"} | json [1m]))",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "logs",
      "title": "All Logs (live tail)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 62 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{container=~\"$container\"} | json | level =~ \"$log_level\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    }
  ]
}
