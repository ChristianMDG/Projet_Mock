# =============================================================================
# TAXIBROUSSE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update with your actual values
# WARNING: Never commit the .env file to version control!
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_USERNAME=taxibrousse
DATABASE_PASSWORD=change_this_password

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_PASSWORD=
REDIS_TIMEOUT=60000
REDIS_POOL_MAX_ACTIVE=15
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=3

# =============================================================================
# OAUTH2 CONFIGURATION
# =============================================================================
# Facebook OAuth
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =============================================================================
# APPLICATION URLs
# =============================================================================
TAXIBROUSSE_URL=https://taxibrousse.mg
VITE_API_URL=https://api.taxibrousse.mg
VITE_CMS_API_URL=https://cms.taxibrousse.mg
VITE_CMS_API_KEY=your_cms_api_key
CMS_API_URL=https://cms.taxibrousse.mg
CMS_API_TOKEN=your_strapi_sms_api_token

# =============================================================================
# MVOLA PAYMENT CONFIGURATION
# =============================================================================
MVOLA_CLIENT_ID=TXB
MVOLA_CLIENT_SECRET=your_mvola_client_secret
MVOLA_BASE_URL=https://api.mvola.mg
MVOLA_PARTNER_NAME=Taxibrousse
MVOLA_USER_ACCOUNT_MSISDN=0343500003
MVOLA_CREDIT_PARTY_MSISDN=0343500004

# =============================================================================
# SMS CONFIGURATION
# =============================================================================
# Orange SMS Configuration (Orange Madagascar)
ORANGE_SENDER_ADDRESS=+697790
ORANGE_SMS_TOKEN=your_orange_sms_token

# =============================================================================
# ELK STACK CONFIGURATION
# =============================================================================
# Kibana Configuration
KIBANA_PUBLIC_URL=https://admin.taxibrousse.mg

# Logstash Configuration
LOGSTASH_HOST=logstash
LOGSTASH_PORT=5000

# =============================================================================
# CMS (Strapi) CONFIGURATION
# =============================================================================
# Database
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=taxibrousse
DATABASE_SSL=false

# Application Keys (generate with: openssl rand -base64 32)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=your_api_token_salt
ADMIN_JWT_SECRET=your_admin_jwt_secret
TRANSFER_TOKEN_SALT=your_transfer_token_salt
JWT_SECRET=your_jwt_secret

# CMS Admin
CMS_ADMIN_JWT_SECRET=your_cms_admin_jwt_secret

# Cloudinary (for media uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
DOMAIN_MAIN=taxibrousse.mg
DOMAIN_CMS=cms.taxibrousse.mg
DOMAIN_API=api.taxibrousse.mg
DOMAIN_DASHBOARD=dashboard.taxibrousse.mg
DOMAIN_ADMIN=admin.taxibrousse.mg

# =============================================================================
# DOCKER IMAGE CONFIGURATION (for production)
# =============================================================================
API_IMAGE=ghcr.io/ofanomezantsoa/taxibrousse-api:latest
CMS_IMAGE=ghcr.io/ofanomezantsoa/taxibrousse-cms:latest
FRONT_IMAGE=ghcr.io/ofanomezantsoa/taxibrousse-front:latest
DASHBOARD_IMAGE=ghcr.io/ofanomezantsoa/taxibrousse-dashboard:latest

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
NODE_ENV=production
MAVEN_OPTS=-Xmx2048m
NODE_OPTIONS=--max-old-space-size=2048
JAVA_OPTS='-Xmx1g -Xms512m'

# =============================================================================
# NOTES
# =============================================================================
# 1. Generate strong passwords with: openssl rand -base64 32
# 2. KIBANA_ENCRYPTION_KEY must be at least 32 characters
# 3. Keep all secrets secure and never commit them to version control
# 4. For local development, use docker-compose.local.yml with default values
# 5. For production, set all environment variables in your deployment system
