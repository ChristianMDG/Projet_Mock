# Production Environment Configuration - Platform Agnostic
# This file is used when building for production deployment
# Environment variables are set during Docker build process

# =============================================================================
# FRONTEND CONFIGURATION (React/Vite)
# =============================================================================
# API Configuration
# WebSocket URL is automatically derived by removing /api from VITE_API_URL
# VITE_API_URL, VITE_CMS_API_URL, VITE_CMS_API_KEY are passed during build

VITE_API_URL=${VITE_API_URL}
VITE_CMS_API_URL=${VITE_CMS_API_URL}
VITE_CMS_API_KEY=${VITE_CMS_API_KEY}

VITE_TAXIBROUSSE_URL=${VITE_TAXIBROUSSE_URL}

# Production environment flag
VITE_ENV=production

# Debug mode off in production
VITE_DEBUG=false

# =============================================================================
# OAUTH2 CONFIGURATION (Frontend)
# =============================================================================
# Facebook & Google OAuth Configuration
# VITE_FACEBOOK_APP_ID and VITE_GOOGLE_CLIENT_ID are passed during build

# Facebook OAuth Configuration
# Create OAuth 2.0 Client IDs:
# https://developers.facebook.com/apps
VITE_FACEBOOK_APP_ID=${FACEBOOK_CLIENT_ID}

# Google OAuth Configuration
# Create OAuth 2.0 Client IDs in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
DOMAIN_MAIN=${DOMAIN_MAIN}
DOMAIN_CMS=${DOMAIN_CMS}
