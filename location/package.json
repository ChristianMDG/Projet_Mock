{
  "name": "location",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.prod.ts",
    "dev:network": "vite --mode development --host",
    "dev:prod": "vite --mode production",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build --mode production",
    "build:server": "SSR_BUILD=true vite build --mode production",
    "test": "vitest run",
    "build:dev": "tsc -b && vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write .",
    "convert:translations": "node scripts/convertTranslations.mjs"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@cloudinary/react": "^1.14.3",
    "@cloudinary/url-gen": "^1.21.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@eslint/eslintrc": "^3.3.1",
    "@fontsource/roboto": "^5.2.5",
    "@mui/icons-material": "^9.0.0",
    "@mui/lab": "^9.0.0-beta.2",
    "@mui/material": "^9.0.0",
    "@mui/x-data-grid": "^9.0.1",
    "@mui/x-date-pickers": "^9.0.0",
    "@stomp/stompjs": "^7.0.0",
    "@tanstack/query-async-storage-persister": "^5.87.1",
    "@tanstack/react-query": "^5.80.6",
    "@tanstack/react-query-persist-client": "^5.87.1",
    "@types/react-window": "^1.8.8",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "express": "^4.21.2",
    "facebook-js-sdk": "^1.0.4",
    "formik": "^2.4.6",
    "i18next": "^25.3.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.0.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.0.0",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.6.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.6.2",
    "react-window": "^1.8.11",
    "short-unique-id": "^5.3.2",
    "sockjs-client": "^1.6.1",
    "yup": "^1.7.0",
    "zustand": "^5.0.6",
    "zustand-persist": "^0.4.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "react-router": "^8.3.0",
    "react-helmet-async": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.80.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-check": "4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "~5.7.2",
    "vite": "^6.4.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.4"
  }
}
